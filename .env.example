PORT=4000
APP_BASE_URL=
WEB_APP_URL=
CORS_ORIGINS=

DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth client credentials.
# Authorized redirect URI: <APP_BASE_URL of this API>/auth/google/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CALLBACK_URL=

# Transactional emails (Resend). When unset, emails are logged/skipped
# in the server console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=

MAPBOX_ACCESS_TOKEN=

# Custom URL scheme the native mobile app listens on for the OAuth deep-link callback.
MOBILE_AUTH_SCHEME=retalkapp

# Optional: when set, /health verifies the local Umami service too.
UMAMI_HEALTHCHECK_URL=
