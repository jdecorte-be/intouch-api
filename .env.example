PORT=4000
APP_BASE_URL=
WEB_APP_URL=
CORS_ORIGINS=

DATABASE_URL=

# SuperTokens core connection (self-hosted, e.g. via Docker+Postgres, or
# SuperTokens' managed service). Auth (email/password, Google, sessions) is
# handled by supertokens-node — see src/supertokens/supertokens.config.ts.
SUPERTOKENS_CONNECTION_URI=
SUPERTOKENS_API_KEY=

# Google OAuth client credentials, used directly by the ThirdParty recipe.
# Authorized redirect URIs (Google Cloud Console): <WEB_APP_URL>/auth/callback
# for the web client (SuperTokens' thirdparty flow redirects straight back
# to the client, not through this API), and <APP_BASE_URL>/auth/mobile-callback
# for the native app — Google only allows https redirect URIs, so this API's
# GET /auth/mobile-callback (see src/auth/auth.controller.ts) bridges to the
# app's intouchapp://auth-callback deep link.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Transactional emails (Resend). When unset, emails are logged/skipped
# in the server console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=

MAPBOX_ACCESS_TOKEN=

# Optional: when set, /health verifies the local Umami service too.
UMAMI_HEALTHCHECK_URL=
