generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                  @id @default(cuid())
  name                  String?
  email                 String?                 @unique
  role                  String                  @default("user") // "user" | "admin"
  bannedAt              DateTime?
  createdAt             DateTime                @default(now())
  passwordHash          String?
  emailVerified         DateTime?
  image                 String?
  photos                String[]                @default([])
  age                   Int?
  gender                String?
  languagesSpoken       String[]                @default([])
  homeNeighborhood      String?
  homeLatitude          Float?
  homeLongitude         Float?
  eventInterests        String[]                @default([])
  eventGoals            String[]                @default([])
  onboardingCompletedAt DateTime?
  accounts              Account[]
  sessions              Session[]
  hostedEvents          Event[]
  chatThreads           ChatThreadParticipant[]
  chatMessages          ChatMessage[]
  chatMessageReactions  ChatMessageReaction[]
  eventReports          EventReport[]
  eventComments         EventComment[]
  eventInterestMarks    EventInterest[]
  notificationsReceived Notification[]          @relation("NotificationRecipient")
  notificationsActedOn  Notification[]          @relation("NotificationActor")

  @@map("users")
}

model ChatThread {
  id        String   @id // "event-chat-<eventId>" or "direct-chat-<eventId>-<sortedUserIds>"
  kind      String // "event" | "direct"
  eventId   String? // hosted or static event id; static events have no DB row, so no relation
  title     String
  subtitle  String
  accent    String
  initials  String
  createdAt DateTime @default(now())

  messages     ChatMessage[]
  participants ChatThreadParticipant[]

  @@map("chat_threads")
}

model ChatThreadParticipant {
  threadId   String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@map("chat_thread_participants")
}

model ChatMessage {
  id         String   @id @default(cuid())
  threadId   String
  authorId   String?
  authorName String
  text       String
  imageUrl   String?
  kind       String   @default("text") // "text" | "system"
  createdAt  DateTime @default(now())

  thread    ChatThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions ChatMessageReaction[]

  @@index([threadId])
  @@map("chat_messages")
}

model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_message_reactions")
}

model Event {
  id             String    @id @default(cuid())
  kind           String    @default("event") // "event" | "group"
  title          String
  description    String    @default("")
  venue          String
  neighborhood   String
  category       String
  startsAt       DateTime
  endsAt         DateTime?
  isFlexibleTime Boolean   @default(false)
  price          String
  capacity       Int
  going          Int       @default(1)
  tags           String[]  @default([])
  latitude       Float
  longitude      Float
  accent         String
  isHidden       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  hostId         String
  host           User      @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@map("events")
}

model EventComment {
  id        String   @id @default(cuid())
  eventId   String // hosted or static event id; static events have no DB row, so no relation
  authorId  String
  text      String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_comments")
}

model EventInterest {
  id        String   @id @default(cuid())
  eventId   String // hosted or static event id; static events have no DB row, so no relation
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_interests")
}

model EventReport {
  id         String   @id @default(cuid())
  eventId    String // hosted or static event id; static events have no DB row, so no relation
  reporterId String
  reason     String // "spam" | "scam" | "inappropriate" | "safety" | "misleading" | "other"
  details    String
  status     String   @default("open") // "open" | "resolved" | "dismissed"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([eventId, reporterId])
  @@index([eventId])
  @@index([status])
  @@map("event_reports")
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  actorId     String?
  kind        String // "comment" | "like" | "invite" | "generated"
  eventId     String? // hosted or static event id; static events have no DB row, so no relation
  title       String
  detail      String?
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
